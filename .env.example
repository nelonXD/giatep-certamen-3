# ==============================================================================
# GIATEP - Archivo de Configuracion de Ejemplo (.env.example)
# Copiar este archivo a .env en la raiz antes de ejecutar:
#   docker compose up --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (para ejecucion en contenedores)
# ------------------------------------------------------------------------------
POSTGRES_DB=giatep
POSTGRES_USER=giatep
POSTGRES_PASSWORD=giatep_dev_secret_2026

# Cadena de conexion para backend (por defecto apunta al servicio 'db' en docker)
ConnectionStrings__Giatep=Host=db;Port=5432;Database=giatep;Username=giatep;Password=giatep_dev_secret_2026;Include Error Detail=true;

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticacion JWT
# ------------------------------------------------------------------------------
# Clave simetrica HMAC-SHA256 (al menos 32 bytes de entropia)
Jwt__Key=ClaveSecretaDeDesarrolloConAlMenos32Bytes_2026!

# ------------------------------------------------------------------------------
# 3. Contrasenas de Usuarios Iniciales (Sembrado / Seed)
# ------------------------------------------------------------------------------
Seed__AdminPassword=AdminSegura123!
Seed__PrevencionPassword=PrevencionSegura123!
Seed__JefaturaPassword=JefaturaSegura123!
Seed__JefaturaSurPassword=JefaturaSurSegura123!

# Carga automatica de 600 casos completos sinteticos (Conjunto RUB26)
Seed__DatosDemostracion=true

# ------------------------------------------------------------------------------
# 4. Inteligencia Artificial y OCR (Reconocimiento Neuronal de Documentos)
# ------------------------------------------------------------------------------
# Motor OCR activo: OcrSpace (predeterminado), Paddle o Tesseract
Ocr__Engine=OcrSpace

# Clave de API gratuita de OCR.space (obtenible en https://ocr.space/ocrapi/freekey)
Ocr__ApiKey=

# ------------------------------------------------------------------------------
# 5. Almacenamiento Local de Evidencias
# ------------------------------------------------------------------------------
Storage__Path=/app/storage/evidencias
