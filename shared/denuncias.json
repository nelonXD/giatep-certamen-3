      },
      {
        "key": "propiedad",
        "label": "Propiedad de la empresa",
        "type": "select",
        "required": false,
        "options": [
          "Pública",
          "Privada"
        ]
      },
      {
        "key": "tipoEmpresa",
        "label": "Tipo de empresa",
