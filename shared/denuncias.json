        "required": true
      },
      {
        "key": "horaIngreso",
        "label": "Hora de ingreso al trabajo",
        "type": "time",
        "required": false
      },
      {
        "key": "horaSalida",
        "label": "Hora de salida del trabajo",
        "type": "time",
        "required": false
      },
      {
        "key": "accidenteDireccion",
        "label": "Dirección del accidente",
        "type": "text",
        "required": true
      },
      {
        "key": "accidenteComuna",
        "label": "Comuna del accidente",
        "type": "text",
        "required": true
      },
      {
        "key": "actividadAccidente",
        "label": "Actividad al momento o justo antes del accidente",
        "type": "textarea",
        "required": true
      },
      {
        "key": "lugarAccidente",
        "label": "Sección, edificio o área del accidente",
        "type": "text",
        "required": true
      },
      {
        "key": "trabajoHabitual",
        "label": "Trabajo habitual",
        "type": "text",
        "required": false
      },
      {
        "key": "realizabaHabitual",
        "label": "¿Realizaba su trabajo habitual?",
        "type": "select",
        "required": false,
        "options": [
          "Sí",
          "No"
        ]
      },
      {
        "key": "clasificacionAccidente",
        "label": "Clasificación del accidente",
        "type": "select",
        "required": true,
        "options": [
          "Grave",
          "Fatal",
          "Otro"
        ]
      },
      {
        "key": "tipoAccidente",
        "label": "Tipo de accidente",
        "type": "select",
        "required": true,
        "options": [
          "Trabajo",
          "Trayecto"
        ]
      },
      {
        "key": "tipoTrayecto",
        "label": "Tipo de trayecto",
        "type": "select",
        "required": true,
        "options": [
          "Domicilio - Trabajo",
          "Trabajo - Domicilio",
          "Entre dos trabajos"
        ],
        "when": {
          "key": "tipoAccidente",
          "values": [
            "Trayecto"
          ]
        }
      },
      {
        "key": "medioPrueba",
        "label": "Medio de prueba del trayecto",
        "type": "select",
        "required": true,
        "options": [
          "Parte de Carabineros",
          "Declaración",
          "Testigos",
          "Otro"
        ],
        "when": {
          "key": "tipoAccidente",
          "values": [
            "Trayecto"
          ]
        }
      },
      {
        "key": "detallePrueba",
        "label": "Detalle del medio de prueba",
        "type": "textarea",
        "required": true,
        "when": {
          "key": "tipoAccidente",
          "values": [
            "Trayecto"
          ]
        }
      }
    ]
  },
