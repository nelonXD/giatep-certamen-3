# Copiar a .env y configurar únicamente en el equipo local.
# TrustServerCertificate=True solo para desarrollo local.
ConnectionStrings__Giatep=Server=.\SQLEXPRESS;Database=GiatepDB;User Id=USUARIO_LOCAL;Password=CAMBIAR;Encrypt=True;TrustServerCertificate=True
Jwt__Key=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
Seed__AdminPassword=CAMBIAR_POR_CONTRASENA_DE_12_O_MAS_CARACTERES
Seed__PrevencionPassword=CAMBIAR_POR_CONTRASENA_DE_12_O_MAS_CARACTERES
Seed__JefaturaPassword=CAMBIAR_POR_CONTRASENA_DE_12_O_MAS_CARACTERES
Seed__JefaturaSurPassword=CAMBIAR_POR_CONTRASENA_DE_12_O_MAS_CARACTERES

# Carga local y repetible de 600 casos completos RUB26, con datos ficticios.
Seed__DatosDemostracion=true

# OCR externo predeterminado: OCR.space gratuito.
# Obtén la clave gratuita en https://ocr.space/ocrapi/freekey. No subir .env a Git.
Ocr__ApiKey=
# OCR.space necesita internet; máximo 1 MB por imagen en el plan gratuito.
# Solo configura estas rutas si Node o el motor están en ubicaciones diferentes.
# Ocr__NodePath=C:/Program Files/nodejs/node.exe
# Ocr__Script=C:/ruta/al/proyecto/backend/ocr/scan.mjs

# Alternativas locales opcionales: Paddle o Tesseract; consulta backend/ocr/README.md.
Ocr__Engine=OcrSpace
# Ocr__PythonPath=C:/ruta/backend/ocr/.venv-paddle/Scripts/python.exe
# Ocr__ModelsPath=C:/ruta/backend/ocr/.paddle-models

# Carpeta privada; por defecto backend/storage/evidencias (fuera de Git).
# Storage__Path=C:/GIATEP/storage/evidencias
